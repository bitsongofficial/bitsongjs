{
  "name": "@bitsongjs/telescope",
  "version": "2.0.0-dev.12",
  "description": "BitsongJS Telescope",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitsongofficial/bitsongjs.git"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./bitsong/*": {
      "types": "./dist/bitsong/*.d.ts",
      "import": "./dist/bitsong/*.mjs",
      "require": "./dist/bitsong/*.cjs"
    },
    "./cosmos/*": {
      "types": "./dist/cosmos/*.d.ts",
      "import": "./dist/cosmos/*.mjs",
      "require": "./dist/cosmos/*.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "codegen": "jiti scripts/codegen.ts",
    "dev": "vitest dev --disable-console-intercept --printConsoleTrace=true --silent=false",
    "lint": "eslint . && prettier -c .",
    "lint:fix": "automd && eslint . --fix && prettier -w .",
    "prepack": "pnpm build",
    "release": "pnpm test && changelogen --release && npm publish && git push --follow-tags",
    "test": "pnpm lint && pnpm test:types && vitest run --coverage",
    "test:types": "tsc --noEmit --skipLibCheck"
  },
  "devDependencies": {
    "@cosmology/telescope": "^1.11.25",
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "^3.0.8",
    "automd": "^0.4.0",
    "changelogen": "^0.6.1",
    "eslint": "^9.22.0",
    "eslint-config-unjs": "^0.4.2",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.2",
    "unbuild": "^3.5.0",
    "vitest": "^3.0.8"
  },
  "dependencies": {
    "@cosmology/lcd": "^0.14.4",
    "@cosmjs/amino": "^0.33.1",
    "@cosmjs/math": "^0.33.1",
    "@cosmjs/proto-signing": "^0.33.1",
    "@cosmjs/stargate": "^0.33.1",
    "@cosmjs/tendermint-rpc": "^0.33.1",
    "bn.js": "^5.2.1"
  }
}
