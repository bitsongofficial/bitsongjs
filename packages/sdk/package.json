{
  "name": "@bitsongjs/sdk",
  "version": "2.0.0",
  "description": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitsongofficial/bitsongjs.git"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "vitest dev",
    "lint": "eslint . && prettier -c .",
    "lint:fix": "automd && eslint . --fix && prettier -w .",
    "prepack": "pnpm build",
    "release": "pnpm test && changelogen --release && npm publish && git push --follow-tags",
    "test": "pnpm lint && pnpm test:types && vitest run --coverage",
    "test:types": "tsc --noEmit --skipLibCheck"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "^3.0.8",
    "automd": "^0.4.0",
    "changelogen": "^0.6.1",
    "eslint": "^9.22.0",
    "eslint-config-unjs": "^0.4.2",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "unbuild": "^3.5.0",
    "vitest": "^3.0.8"
  },
  "packageManager": "pnpm@10.6.1",
  "dependencies": {
    "@bitsongjs/telescope": "workspace:*",
    "@chain-registry/types": "^0.50.100",
    "@cosmjs/amino": "^0.33.1",
    "@cosmjs/cosmwasm-stargate": "^0.33.1",
    "@cosmjs/crypto": "^0.33.1",
    "@cosmjs/math": "^0.33.1",
    "@cosmjs/proto-signing": "^0.33.1",
    "@cosmjs/stargate": "^0.33.1",
    "@cosmjs/tendermint-rpc": "^0.33.1",
    "@cosmjs/utils": "^0.33.1",
    "chain-registry": "^1.69.164",
    "cosmjs-types": "^0.9.0"
  },
  "patchedDependencies": {
    "@cosmjs/stargate@0.33.1": "patches/@cosmjs%2Fstargate@0.33.0.patch",
    "@cosmjs/cosmwasm-stargate@0.33.1": "patches/@cosmjs%2Fcosmwasm-stargate@0.33.0.patch",
    "@cosmjs/tendermint-rpc@0.33.1": "patches/@cosmjs%2Ftendermint-rpc@0.33.0.patch"
  }
}
